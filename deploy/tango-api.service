[Unit]
Description=Tango Puzzle API (FastAPI/Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
