[Unit]
Description=Ambil puzzle Tango harian tepat setelah LinkedIn ganti soal (tengah malam waktu Pacific)

[Timer]
# 00:01 PT = 15:01 WIB (musim dingin) / 14:01 WIB (musim panas), DST diurus systemd
OnCalendar=*-*-* 00:01:00 America/Los_Angeles
# percobaan ulang kalau yang pertama gagal / LinkedIn telat ganti soal
OnCalendar=*-*-* 00:30:00 America/Los_Angeles
OnBootSec=2min
Persistent=true

[Install]
WantedBy=timers.target
